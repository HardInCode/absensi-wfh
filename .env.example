# ===== Dipakai oleh Docker Compose (file ini disalin ke .env di ROOT repo) =====
# Alur lokal tanpa Docker tetap memakai backend/.env (tidak berubah).

# MySQL
MYSQL_ROOT_PASSWORD=ganti-password-root
DB_NAME=absensi_wfh
DB_USER=absensi_user
DB_PASSWORD=ganti-password-db
# true = tabel dibuat otomatis (cocok untuk demo). Produksi: pakai migrasi.
DB_SYNCHRONIZE=true

# JWT (minimal 32 karakter; hindari karakter "$")
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter-ya
JWT_EXPIRES_IN_SECONDS=28800
BCRYPT_ROUNDS=10

# Port yang terbuka di host
FRONTEND_PORT=8080
GATEWAY_PORT=3000

# Build arg frontend. Biarkan "/api" agar lewat proxy Nginx (tanpa CORS).
VITE_API_URL=/api
